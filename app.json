{
  "expo": {
    "name": "Lotty Go",
    "slug": "lotty-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lottygo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.lottygo.app",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lotty Go uses your location to request rides and match drivers."
      }
    },
    "android": {
      "package": "za.co.lottygo.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lotty Go uses your location to request rides and match drivers."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4279c799-a15a-4abb-9098-8961bf10113d"
      }
    },
    "owner": "stephen132"
  }
}
