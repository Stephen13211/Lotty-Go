{
  "expo": {
    "name": "Lotty Go",
    "slug": "lotty-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lottygo",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.lottygo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lotty Go uses your location to request rides and match drivers."
      }
    },
    "android": {
      "package": "za.co.lottygo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lotty Go uses your location to request rides and match drivers."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4279c799-a15a-4abb-9098-8961bf10113d"
      }
    },
    "owner": "stephen132",
    "backgroundColor": "#0B0B0D",
    "splash": {
      "backgroundColor": "#0B0B0D",
      "resizeMode": "contain"
    }
  }
}