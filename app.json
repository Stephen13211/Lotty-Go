{
  "expo": {
    "name": "Lotty Go",
    "slug": "lotty-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lottygo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.lottygo",
      "config": { "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY" },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lotty Go uses your location to request rides and match drivers."
      }
    },
    "android": {
      "package": "com.yourname.lottygo",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "config": { "googleMaps": { "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY" } }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "Lotty Go uses your location to request rides and match drivers." }],
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": { "typedRoutes": true }
  }
}

